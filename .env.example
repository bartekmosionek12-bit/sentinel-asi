# Sentinel ASI: wzór konfiguracji. Skopiuj do .env i uzupełnij.
# Plik .env NIE trafia do repozytorium.

# --- ogólne ---
APP_ENV=development
LOG_LEVEL=INFO
# Tryb demo: zezwala seed_demo na zgodę L2 wyłącznie w sieci demo-lab. Domyślnie wyłączony.
DEMO_MODE=false
# Do kiedy obowiązuje zgoda seed_demo (ISO 8601, UTC). Pusta wartość = brak zgody.
DEMO_APPROVAL_EXPIRES_AT=
# CIDR wewnętrznej sieci demo-lab (musi zgadzać się z docker-compose.yml).
DEMO_LAB_CIDR=172.30.99.0/24

# --- baza danych ---
# Administrator bazy: zna go tylko usługa db-init, która zakłada dwóch użytkowników poniżej.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
# Użytkownik aplikacji (schemat public) i Keycloaka (schemat keycloak); żaden nie ma dostępu
# do schematu drugiego. Test agenta (moduł 19) ma własnego użytkownika: jest właścicielem
# tabel wyników testu, aplikacja może je tylko czytać. Ustaw cztery różne hasła.
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=change-me-app
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak
HARNESS_DB_USER=sentinel_harness
HARNESS_DB_PASSWORD=change-me-harness
POSTGRES_DB=sentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- kolejka ---
REDIS_URL=redis://redis:6379/0

# --- zakres skanowania ---
# Plik z allowlistą domen i CIDR. Domyślnie pusty zakres: nic nie jest dozwolone.
# Dla demo: /app/rules/scope.demo.yaml (ustawia go scripts/seed_demo.sh).
SCOPE_FILE=/app/rules/scope.yaml

# --- API i frontend ---
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Adres, pod którym użytkownicy otwierają interfejs (bez końcowego ukośnika). Z niego
# Keycloak buduje adresy logowania, a API sprawdza wydawcę tokenu.
PUBLIC_URL=http://localhost:8080
# Interfejs sieciowy hosta dla portu 8080. Domyślnie tylko lokalnie. Wystawienie w sieci
# (0.0.0.0) wymaga HTTPS przed nginx: ciasteczka logowania mają flagę Secure.
SENTINEL_BIND=127.0.0.1

# --- logowanie (Keycloak) ---
# Konto techniczne Keycloaka. Konsola /auth/admin nie jest wystawiona przez nginx;
# konta używają tylko skrypty (demo_users.sh, breakglass.sh) przez kcadm.sh w kontenerze.
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Konta demo (tylko DEMO_MODE=true, scripts/demo_users.sh). Puste = wygenerowane i zapisane
# w data/demo-credentials.env (poza Gitem).
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_TOTP_SECRET=
DEMO_EDITOR_PASSWORD=
DEMO_MODIFIER_PASSWORD=
DEMO_VIEWER_PASSWORD=

# --- agent i MCP (Etap 5) ---
# Sekret konta usługowego agenta (klient sentinel-agent w Keycloaku). Tylko z nim serwer MCP
# przyjmuje wywołania narzędzi. Wygeneruj: openssl rand -hex 32
AGENT_CLIENT_SECRET=
# Sekret konta usługowego kill switcha (klient sentinel-killswitch, tylko view/manage-clients).
# API wyłącza nim klienta agenta w Keycloak. Wygeneruj: openssl rand -hex 32
KILLSWITCH_CLIENT_SECRET=
# OpenBao (poświadczenia SSH na 15 minut) nie wymaga nic w .env: bao-init przy pierwszym
# starcie inicjuje magazyn, a klucze odpieczętowania zapisuje w wolumenie openbao-init
# (tylko demo; w produkcji klucze trzyma człowiek, nie wolumen).

# --- LLM (lokalnie, Ollama) ---
# Adres musi być lokalny (nazwa usługi, localhost albo prywatny adres IP).
OLLAMA_URL=http://ollama:11434
# Domyślny model: Qwen3 4B Q4_K_M (eval v2: 93% odpowiedzi przechodzi walidator,
# uzasadnienie w eval/RESULTS.md). Opcja: bielik-4.5b-q4km (lepsza polszczyzna, gorsza
# wierność faktom; kwantyzacja obrazem llama.cpp z GHCR niezweryfikowana, patrz README).
# Pusty albo niepobrany model = praca bez modelu (wyjaśnienia z szablonu).
# Model pobiera scripts/fetch_models.sh.
LLM_MODEL=qwen3-4b-q4km
LLM_NUM_CTX=4096
# 0 = wykryj liczbę fizycznych rdzeni automatycznie
LLM_NUM_THREAD=0
OLLAMA_KEEP_ALIVE=-1
# Sentek: model rozpoznaje tylko intencję pytania; po tylu sekundach słowa kluczowe.
ASSISTANT_USE_MODEL=true
ASSISTANT_TIMEOUT_SECONDS=4

# --- zewnętrzny LLM: domyślnie WYŁĄCZONY, dostaje tylko dane zanonimizowane ---
# Protokół zgodny z OpenAI (/chat/completions), tylko https. Użycie wyłącznie na żądanie
# z interfejsu, każde wywołanie trafia do audit logu.
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_URL=
EXTERNAL_LLM_MODEL=
EXTERNAL_LLM_API_KEY=

# --- feedy ---
# offline = snapshoty z plików (domyślna ścieżka demo), online = pobieranie z sieci
FEEDS_MODE=offline
NVD_API_KEY=

# --- powiadomienia ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS przed logowaniem (zostaw true poza demo). Demo z Mailpit (profil demo):
# SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false, podgląd: http://localhost:8025
SMTP_STARTTLS=true

# Adres, na który trafiają powiadomienia, digesty i raporty e-mailem (zawsze wersja
# „W skrócie” z PDF, bez danych technicznych).
NOTIFY_EMAIL_TO=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
